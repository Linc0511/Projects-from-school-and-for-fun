// Function to print a fixed-width string with padding
void print_fixed_width(char* str) {
    printf(" %-3s |", str);
}
void print_header(int num_inputs, char* expressions[]) {
    // Print the input column headers
    for (int i = 0; i < num_inputs; i++) {
        if (strlen(expressions[i]) == 1)
        printf(" %c |", 'A' + i);
    }
    
    // Print the expression column headers
    for (int i = 0; i < num_inputs + 1; i++) {
        if (strlen(expressions[i]) == 2) {
            printf("  %s ", expressions[i]);
        }
        else if (strlen(expressions[i]) == 3) {
            printf(" %s ", expressions[i]);
        }
        printf("|");
    }
    
    printf("\n");
}

void generate_truth_table(int num_inputs, char* expressions) {
    int num_rows = 1 << num_inputs;  // Calculate the number of rows (2^n)

    for (int row = 0; row < num_rows; row++) {
        for (int input = -1; input < num_inputs; input++) {
            bool value = (row & (1 << input)) != 0; // Extract the bit value for the input
            printf("  %d  |", value);
        }

        // Evaluate and print the result for each expression column
        for (int exp = 0; exp < num_inputs; exp++) {
            char left_operand = expressions[exp] & 0xF0;
            char operator = expressions[exp] & 0x0F;

            int left_index = left_operand - 'A';
            int right_index = operator - 'A';

            bool result;
            if (operator == '*') {
                result = ((row & (1 << left_index)) != 0) && ((row & (1 << right_index)) != 0);
            } else if (operator == '+') {
                result = ((row & (1 << left_index)) != 0) || ((row & (1 << right_index)) != 0);
            } else if (operator == '^') {
                result = (((row & (1 << left_index)) != 0) ^ ((row & (1 << right_index)) != 0));
            }
             else if (operator == '~') {
                result = (((row & (1 << left_index)) != 0) ^ ((row & (1 << right_index)) != 0));
            } 

            // Print '0' or '1' based on the result
            char result_char = result ? '1' : '0';
            printf("  %c  |", result_char);
        }
        printf("\n");
    }
}


